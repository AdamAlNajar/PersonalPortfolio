<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | Adam Al Najar</title>
  <meta name="description" content="{% if description %}{{ description }}{% else %}Portfolio of Adam Al Najar — game developer and maker based in the UAE.{% endif %}">
  <meta name="theme-color" content="#0b0d11">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Adam Al Najar">
  <meta property="og:title" content="{{ title }} | Adam Al Najar">
  <meta property="og:description" content="{% if description %}{{ description }}{% else %}Portfolio of Adam Al Najar — game developer and maker based in the UAE.{% endif %}">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230b0d11'/%3E%3Crect x='6' y='6' width='12' height='12' fill='%23ff4d24'/%3E%3Crect x='20' y='6' width='6' height='6' fill='%23e8e6df'/%3E%3Crect x='20' y='20' width='6' height='6' fill='%23ff4d24'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/styles.css">
  <noscript><style>.reveal { opacity: 1; transform: none; }</style></noscript>
</head>
<body class="{{ body_class }}">
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="/" aria-label="Adam Al Najar — home">
        <span class="brand-mark" aria-hidden="true">A</span>
        <span>ADAM<span class="brand-dim">.AL_NAJAR</span></span>
      </a>
      <nav class="site-nav" aria-label="Main navigation">
        <ul>
          <li><a href="/" {% if page.url == '/' %}aria-current="page"{% endif %}><span class="nav-num">01</span>Home</a></li>
          <li><a href="/about/" {% if page.url == '/about/' %}aria-current="page"{% endif %}><span class="nav-num">02</span>About</a></li>
          <li><a href="/projects/" {% if page.url == '/projects/' %}aria-current="page"{% endif %}><span class="nav-num">03</span>Projects</a></li>
          <li><a href="/services/" {% if page.url == '/services/' %}aria-current="page"{% endif %}><span class="nav-num">04</span>Services</a></li>
          <li><a href="/contact/" {% if page.url == '/contact/' %}aria-current="page"{% endif %}><span class="nav-num">05</span>Contact</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main" class="site-main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p>© <span id="year">2026</span> Adam Al Najar — game developer in the UAE</p>
      <div class="footer-links">
        <a href="https://github.com/AdamAlNajar">GitHub</a>
        <a href="https://adamalnajar.itch.io">itch.io</a>
        <a href="mailto:adam.alnajar@yahoo.com">Email</a>
        <a href="/privacy-policy/">Privacy</a>
        <a href="/csam-notice/">Child safety</a>
      </div>
    </div>
  </footer>

  <script src="/assets/script.js" defer></script>
</body>
</html>
